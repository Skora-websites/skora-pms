{
  "name": "skoracare_old",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:status": "tsx scripts/migrate.ts --status",
    "db:seed": "tsx scripts/seed.ts",
    "db:check": "node scripts/check-db-schema.mjs",
    "check:storage": "node scripts/check-storage-guard.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:links": "node scripts/check-shell-links.mjs",
    "test": "tsx --test --conditions react-server --test-force-exit --test-concurrency=1 \"**/__tests__/*.test.ts\"",
    "test:watch": "tsx --test --watch --conditions react-server --test-force-exit --test-concurrency=1 \"**/__tests__/*.test.ts\"",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-pdf/renderer": "^4.6.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "mysql2": "^3.23.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "agentation": "^3.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
