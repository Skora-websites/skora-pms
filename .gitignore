# dependencies
/node_modules
/.pnp
.pnp.*

# Database dumps/exports — contain the operator password hash, never commit
skoracares-db-export.sql
/*-db-export.sql

# testing
/coverage

# next.js
/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — .env plus any backup or variant (.env.bak, .env.prod.bak, …),
# so a dated env backup can never be swept up by `git add .`
.env
.env.*
!.env.example

# uploaded / generated files (PHI-safe non-public storage)
/storage/uploads/

# local tooling artifacts
.freebuff/

# agent/harness workspaces + local-only audit reports (never deploy source)
/.perch/
AUDIT_REPORT.md
# audit HTML renderings — safe to keep on disk, but a `git add .` must never stage them
/audit.html
/AUDIT*.html
/SECURITY_AUDIT_*.md

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev database + tooling
/.local/

# drizzle generated migrations are committed via /drizzle, but not the journal cache
/drizzle/meta/_journal.json.tmp
.aider*

# runtime logs / screenshots
*.log
tmp-shot-*.png
.playwright-mcp/

# local machine artifacts (DB dumps, large archive, scratch output)
/skoracare_old.zip
/tsc-baseline.txt
/qpid.mjs
/.claude/
/backups/

# IDE
.idea/
*.iml

# the native Expo mobile app lives IN-REPO but is local-only: its own git
# history, its own node_modules, NOT pushed with the web app (user decision)
/skora-mobile/

# large local archives — never commit
/pms.zip
*.zip

# scratch probes
*.tmp.*

# harness command definitions (not application source)
/.omp/
/skoracares-app/
