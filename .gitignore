/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*.local
.env

# uploaded / generated files (PHI-safe non-public storage)
/storage/uploads/

# local tooling artifacts
.freebuff/

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev database + tooling
/.local/

# drizzle generated migrations are committed via /drizzle, but not the journal cache
/drizzle/meta/_journal.json.tmp
.aider*

# runtime logs / screenshots
*.log
tmp-shot-*.png
.playwright-mcp/

# local machine artifacts (DB dumps, large archive, scratch output)
/skoracare_old.zip
/tsc-baseline.txt
/qpid.mjs
/.claude/
/backups/

# IDE
.idea/
*.iml

# large local archives — never commit
/pms.zip
*.zip

# scratch probes
*.tmp.mjs

# harness command definitions (not application source)
/.omp/
