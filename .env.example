# ── SkoraCares Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# IMPORTANT: Never commit the real .env file to version control.

# Application
NEXT_PUBLIC_APP_NAME="SkoraCares"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database ---
# MySQL connection string (Drizzle ORM + mysql2)
# Format: mysql://user:password@host:port/database
DATABASE_URL="mysql://root:password@localhost:3306/skoracare"

# Connection pool tuning (optional)
# DB_POOL_CONNECTION_LIMIT=10
# DB_POOL_QUEUE_LIMIT=0
# DB_CONNECT_TIMEOUT=10000

# Enable SSL for MySQL (set to "true" for managed DBs like DigitalOcean, AWS RDS, PlanetScale)
# DB_SSL=false
# DB_SSL_CA=/path/to/ca-cert.pem  (optional — only if custom CA is needed)

# --- Authentication ---
# Generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters. Rotate immediately if compromised.
AUTH_SECRET="change-me-to-a-random-64-char-hex-string"

# --- File Uploads ---
# Maximum file size in bytes (default: 10 MB)
# MAX_UPLOAD_SIZE=10485760

# --- Rate Limiting ---
# Trusted proxy header for real client IP when behind a reverse proxy.
# Set to "x-forwarded-for" if using Cloudflare, Nginx, etc.
# TRUSTED_PROXY_HEADER=x-forwarded-for

# --- Email (optional) ---
# Configure for transactional emails (consent, password reset, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-password
# SMTP_FROM_ADDRESS=noreply@skoracares.com
# SMTP_FROM_NAME="SkoraCares"

# --- Next.js ---
NODE_ENV="development"