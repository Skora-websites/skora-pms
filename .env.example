# ── SkoraCares Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# IMPORTANT: Never commit the real .env file to version control.
# Every key the application reads is documented here. Runtime defaults for
# numeric/tunable values are centralized in lib/config.ts.

# ── Application ───────────────────────────────────────────────────────────
# Public display name and absolute base URL (used in emails + consent links).
NEXT_PUBLIC_APP_NAME="SkoraCares"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OPTIONAL dev-only login-page hint. Set in .env (development only!) to show
# a "Demo accounts" box on /login. Leave unset in production — the box never
# renders without it, and no credentials are hardcoded in the app.
# NEXT_PUBLIC_DEMO_HINT_EMAIL="doctor@gmail.com"
# NEXT_PUBLIC_DEMO_HINT_EXTRA_EMAILS="patient@gmail.com · admin@gmail.com"
# NEXT_PUBLIC_DEMO_HINT_PASSWORD="Admin@123"

# ── Database ──────────────────────────────────────────────────────────────
# MySQL connection string (Drizzle ORM + mysql2)
# Format: mysql://user:password@host:port/database
DATABASE_URL="mysql://root@localhost:3306/skoracares_db"

# Connection pool tuning (optional; defaults in lib/config.ts)
# DB_POOL_CONNECTION_LIMIT=10
# DB_POOL_QUEUE_LIMIT=0
# DB_CONNECT_TIMEOUT=10000

# Enable SSL for MySQL (set to "true" for managed DBs like DigitalOcean, AWS RDS, PlanetScale)
# DB_SSL=false
# DB_SSL_CA=/path/to/ca-cert.pem  (optional — only if custom CA is needed)

# ── Authentication ────────────────────────────────────────────────────────
# Generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters. Rotate immediately if compromised.
AUTH_SECRET="change-me-to-a-random-64-char-hex-string"

# Session lifetime in SECONDS (cookie maxAge = JWT expiry). Default: 30 days.
# SESSION_MAX_AGE=2592000

# ── File Uploads ──────────────────────────────────────────────────────────
# Generic upload cap in bytes (consult PDFs etc.). Default: 10 MB.
# MAX_UPLOAD_SIZE=10485760
# Consent file cap in bytes. Default: 5 MB (legacy parity).
# MAX_CONSENT_FILE_SIZE=5242880

# ── Rate Limiting ─────────────────────────────────────────────────────────
# Sliding-window limits (defaults mirror the security audit):
#   login: 5 attempts / 15 min (window is also the lockout duration)
#   signup: 3 / hour · consent: 10 / hour · demo: 5 / hour
#   chat poll: 30 / minute · SOS: 1 / minute
# SECURITY: required in production when behind a reverse proxy. getClientIp()
# reads ONLY this header when set; without it every request resolves to
# "unknown" (it never trusts spoofable x-forwarded-for/x-real-ip). Set it to
# a header your proxy overwrites on every request, e.g. x-forwarded-for.
# TRUSTED_PROXY_HEADER=x-forwarded-for
# RATE_LIMIT_LOGIN=5
# RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
# RATE_LIMIT_SIGNUP=3
# RATE_LIMIT_OTP_VERIFY=10
# RATE_LIMIT_CONSENT=10
# RATE_LIMIT_DEMO=5
# RATE_LIMIT_CHAT_POLL=30
# RATE_LIMIT_EMERGENCY=1

# ── Email (SMTP) ──────────────────────────────────────────────────────────
# Transactional emails (consent, notifications, OTP fallback).
# SMTP_FROM_ADDRESS is also the last-resort "From" fallback in lib/mail.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-password
# SMTP_FROM_ADDRESS=noreply@skoracares.com
# SMTP_FROM_NAME="SkoraCares"

# ── Web Push (VAPID) ──────────────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys --json
# While empty, push notifications are disabled (app degrades gracefully).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@skoracare.com
# Push endpoints are allowlisted (FCM/Mozilla/Apple/WNS). Add extra hosts
# (e.g. a self-hosted push server) comma-separated; the server refuses to
# POST to any other host (SSRF guard).
# PUSH_ALLOWED_ENDPOINT_HOSTS=

# ── WhatsApp ──────────────────────────────────────────────────────────────
# Legacy gateway credentials (config/services.php parity). While empty,
# WhatsApp sends are skipped with a console warning.
# WHATSAPP_APPKEY=
# WHATSAPP_AUTHKEY=
# WHATSAPP_API_URL=https://whatsapp.rajatmarketingss.online/api/create-message

# ── Marketing / Demo ──────────────────────────────────────────────────────
# Where "book a demo" notifications are sent. Falls back to the super-admin
# account email when unset.
# DEMO_NOTIFY_EMAIL=demo@skoracares.com

# ── Razorpay (package checkout) ───────────────────────────────────────────
# Test keys from https://dashboard.razorpay.com/app/keys
# While empty, the checkout UI hides itself (pricing shows normal links).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Next.js ───────────────────────────────────────────────────────────────
NODE_ENV="development"

# ── Seed / e2e / verification tooling ─────────────────────────────────────
# Shared by scripts/seed.ts, scripts/env.mjs and e2e/test-env.ts so seeding,
# verification and tests always agree. Defaults keep the historical demo
# values (these are dev fixtures, not production secrets).
# SEED_PASSWORD="Admin@123"
# SEED_SUPER_ADMIN_EMAIL="admin@gmail.com"
# SEED_DOCTOR_EMAIL="doctor@gmail.com"
# SEED_PATIENT_EMAIL="patient@gmail.com"
# SEED_RECEPTIONIST_EMAIL="receptionist@gmail.com"
# SEED_OWNER_EMAIL="owner@gmail.com"
# SEED_MANAGER1_EMAIL="manager1@gmail.com"
# SEED_MANAGER2_EMAIL="manager2@gmail.com"
# E2E_BASE_URL="http://localhost:3100"
# E2E_DB_HOST=127.0.0.1
# E2E_DB_PORT=3306
# E2E_DB_USER=root
# E2E_DB_PASSWORD=""
# E2E_DB_NAME=skoracares_db
